<?xml version="1.0" encoding="UTF-8"?>
<!-- DoorLabs Outlook-Add-in. Vorlage: `npm run build:addin` ersetzt https://kunzejulian9-maker.github.io/Add-ins-Test (Adresse, unter der die Dateien liegen, ohne / am Ende). -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>2754276e-539f-4f2b-b4e4-e242dccf0b34</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>DoorLabs</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="DoorLabs">
    <Override Locale="de-DE" Value="DoorLabs"/>
    <Override Locale="fr-FR" Value="DoorLabs"/>
    <Override Locale="it-IT" Value="DoorLabs"/>
  </DisplayName>
  <Description DefaultValue="Mark an appointment for the DoorLabs door sign: choose status and colour.">
    <Override Locale="de-DE" Value="Termin fürs DoorLabs-Türschild markieren: Status und Farbe wählen."/>
    <Override Locale="fr-FR" Value="Marquer un rendez-vous pour la plaque de porte DoorLabs : choisir statut et couleur."/>
    <Override Locale="it-IT" Value="Contrassegna un appuntamento per la targa DoorLabs: scegli stato e colore."/>
  </Description>
  <IconUrl DefaultValue="https://kunzejulian9-maker.github.io/Add-ins-Test/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://kunzejulian9-maker.github.io/Add-ins-Test/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://doorlabs.ch"/>
  <AppDomains>
    <AppDomain>https://doorlabs.ch</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://kunzejulian9-maker.github.io/Add-ins-Test/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="doorlabsGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="doorlabsOpenPane">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://kunzejulian9-maker.github.io/Add-ins-Test/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://kunzejulian9-maker.github.io/Add-ins-Test/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://kunzejulian9-maker.github.io/Add-ins-Test/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://kunzejulian9-maker.github.io/Add-ins-Test/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://kunzejulian9-maker.github.io/Add-ins-Test/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="DoorLabs"/>
        <bt:String id="Button.Label" DefaultValue="DoorLabs sign">
          <bt:Override Locale="de-DE" Value="DoorLabs-Schild"/>
          <bt:Override Locale="fr-FR" Value="Plaque DoorLabs"/>
          <bt:Override Locale="it-IT" Value="Targa DoorLabs"/>
        </bt:String>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Choose status and colour for the DoorLabs door sign during this appointment.">
          <bt:Override Locale="de-DE" Value="Status und Farbe für das DoorLabs-Türschild während dieses Termins wählen."/>
          <bt:Override Locale="fr-FR" Value="Choisir statut et couleur de la plaque DoorLabs pendant ce rendez-vous."/>
          <bt:Override Locale="it-IT" Value="Scegli stato e colore della targa DoorLabs durante questo appuntamento."/>
        </bt:String>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
